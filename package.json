{
  "name": "taskflow",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/workers/worker.ts",
    "scheduler": "tsx watch src/workers/scheduler.ts",
    "recovery": "tsx watch src/workers/recovery.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/worker.js",
    "start:scheduler": "node dist/workers/scheduler.js",
    "start:recovery": "node dist/workers/recovery.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --forceExit",
    "test:crash-recovery": "tsx src/scripts/crash-recovery-e2e.ts",
    "loadtest": "node loadtest.js",
    "start:all": "node dist/all.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Distributed job queue with priorities, retries, DLQ, crash recovery and a live dashboard",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
    "jest": "^30.5.1",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
