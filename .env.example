# --- Required ---
MONGO_URI=mongodb://localhost:27017/taskflow
REDIS_URL=redis://localhost:6379
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# --- API ---
PORT=3000
# When set, POST /auth/token (and the dashboard login) require this key in x-api-key.
# Strongly recommended in any deployment reachable from the internet.
AUTH_API_KEY=
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60

# --- Worker simulation ---
JOB_SLEEP_MS=2000
FAILURE_RATE=0.2
FORCE_SUCCESS=false
CRASH_TEST=false

# --- Heartbeats / recovery ---
HEARTBEAT_INTERVAL_MS=5000
HEARTBEAT_TIMEOUT_MS=15000
RECOVERY_POLL_INTERVAL_MS=2000

# --- docker compose ---
WORKER_REPLICAS=3
API_PORT=3000
